{
  "name": "kiki-insights",
  "version": "0.1.0",
  "description": "Kiki Insights — internal per-user analytics microsite (Fastify + Postgres)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc && cp src/schema.sql dist/schema.sql",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "jose": "^6.2.2",
    "pg": "^8.13.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.10",
    "eslint": "^9.20.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}

# ─── Kiki Insights — environment ──────────────────────────────────────────
# Copy to .env.local for local dev. On Railway, set these as service variables.

# HTTP
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Postgres — SHARED with the backend. Point this at the SAME Railway Postgres the
# backend uses: Insights reads the backend-owned `users` + `monthly_usage` tables
# and owns only `events`/`sessions`/`drawings`. On Railway, set this as a
# reference to the Postgres service (same value the backend's DATABASE_URL has).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kiki_insights

# Ingest auth ───────────────────────────────────────────────────────────────
# Shared with the prod backend so we can verify iOS access tokens (verify-only,
# we never sign). MUST equal the backend's JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=change-me-must-match-backend-access-secret
# Service key the prod backend presents on x-insights-key to dual-write its
# server-side events. Any long random string; set the same value on the backend.
INSIGHTS_INGEST_KEY=change-me-long-random-service-key

# Dashboard auth ─────────────────────────────────────────────────────────────
# Single admin password for the internal dashboard login.
ADMIN_PASSWORD=change-me
# HS256 secret used to sign the admin session cookie (>= 32 chars).
ADMIN_SESSION_SECRET=change-me-at-least-32-characters-long-xx

# Blob storage ───────────────────────────────────────────────────────────────
# Directory where drawing thumbnails / generated images / (later) videos are
# written. On Railway, mount a persistent volume here.
BLOB_DIR=./blobs

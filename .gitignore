# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
ios/**/xcuserdata/
ios/**/*.xcscmblueprint
ios/**/DerivedData/
ios/**/*.moved-aside
ios/**/*.pbxuser
ios/**/*.perspectivev3
ios/**/xcshareddata/WorkspaceSettings.xcsettings

# Swift Package Manager
ios/Packages/**/.build/
ios/.swiftpm/
# Stray SwiftPM build artifacts that occasionally land at package root
ios/Packages/**/*.d
ios/Packages/**/*.o
ios/Packages/**/*.swiftdeps
ios/Packages/**/*.swiftdeps~

# Backend
backend/node_modules/
backend/dist/
backend/.env

# Local secrets
.env.local

# Dev test-client debug output (model-servers/dev/{image,video}_client.py)
model-servers/dev/*.jpg
model-servers/dev/*.mp4

# Python
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
*.swp
*~

# Claude Code session state (per-checkout, don't commit)
.claude/

# BrushHarness transient artifacts (fetched fixtures + rendered PNGs)
ios/Packages/CanvasModule/BrushHarness/fixtures/
ios/Packages/CanvasModule/BrushHarness/output/

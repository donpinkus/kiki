# =============================================================================
# Backend env template
# =============================================================================
# This file documents the env vars the backend reads. Two important notes:
#
# 1) The deployed backend runs on RAILWAY — Railway is the source of truth
#    for these values in production. The "REQUIRED" section below is what
#    Railway needs set (and currently has set; ask the team for current
#    values if you need to change them).
#
# 2) Operational SCRIPTS in `backend/scripts/` read a SUBSET of these from
#    `<repo-root>/.env.local` (NOT from backend/.env or this file).
#
# `npm run dev` (the local backend server) doesn't auto-load any .env
# file — if you need to run it locally you must `export` the required
# vars in your shell first. In practice, local backend dev is rare since
# the iPad client connects to Railway directly.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── REQUIRED — backend won't start without these ─────────────────────────

# JWT signing — both required, both must be ≥32 bytes, must differ.
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Apple Sign-In audience — your iOS bundle id (e.g. com.don.Kiki). Also used as
# the bundle id when verifying StoreKit transactions + App Store notifications.
APPLE_BUNDLE_ID=

# Numeric App Store app id ("Apple ID" in App Store Connect → App Information).
# Required to verify PRODUCTION StoreKit transactions; until set, the backend
# verifies Sandbox/TestFlight transactions but rejects Production ones. Leave
# unset/0 before the app is live on the App Store.
APPLE_APP_APPLE_ID=

# Postgres connection string — durable store for user accounts (`users` table)
# and the per-user monthly fal-spend ledger (`monthly_usage`). Railway injects
# this from the Postgres addon; the backend fail-fasts without it.
DATABASE_URL=

# fal.ai API key — server-side only (CLAUDE.md #3). Required when
# IMAGE_PROVIDER=fal (the live image path relays to fal's hosted FLUX.2-klein
# with `Authorization: Key $FAL_KEY`).
FAL_KEY=

# ─── Production runtime gates ─────────────────────────────────────────────

# Reject WebSocket connections that don't carry a valid Bearer JWT. Set to
# `false` for local dev only; production must always be `true`.
AUTH_REQUIRED=true

# Live image provider: `fal` (hosted fal-ai/flux-2/klein/realtime — production,
# the code default) or `lambda` (our own image server on a Lambda Cloud H100 —
# dev/test-account toggle).
IMAGE_PROVIDER=fal

# Free fal drawing-spend cap (USD) per unsubscribed user per UTC month. Test
# accounts (users.is_test_account=true) + active subscribers are exempt.
# 0 effectively disables the cap. Default 10.
FREE_TIER_FAL_USD=10

# ─── Optional tuning ──────────────────────────────────────────────────────

# Close the fal realtime WS this many ms after the last frame (then reopen on
# the next stroke) so idle runner time isn't billed. 0 = disabled. Prod = 2000.
# FAL_IDLE_CLOSE_MS=2000

# Kiki Insights (internal per-user analytics microsite). When BOTH are set,
# backend events are mirrored to Insights' /ingest (best-effort).
# INSIGHTS_INGEST_KEY must match the value on the Insights service.
# Unset → no-op.
# INSIGHTS_URL=https://kiki-insights-production.up.railway.app
# INSIGHTS_INGEST_KEY=<same long random string set on the Insights service>

# ─── Lambda Cloud (IMAGE_PROVIDER=lambda dev path) ────────────────────────
# LAMBDA_API_KEY=<cloud.lambda.ai/api-keys>
# LAMBDA_DEV_POOL_ENABLED=true
# LAMBDA_REGION=us-south-2
# LAMBDA_INSTANCE_TYPE=gpu_1x_h100_sxm5
# Static instance override (takes precedence over the dev pool):
# LAMBDA_IMAGE_URL=wss://<ip>:8766/ws?token=<hex>

{
  "name": "kiki-backend",
  "version": "0.1.0",
  "description": "Kiki — sketch-to-image backend (Fastify + TypeScript)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/postgres/schema.sql dist/postgres/schema.sql",
    "start": "node dist/index.js",
    "test": "vitest",
    "db:migrate": "tsx src/postgres/migrate.ts",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "deploy": "tsx scripts/deploy.ts",
    "sync-all": "tsx scripts/sync-all-dcs.ts",
    "add-dc-volume": "tsx scripts/add-dc-volume.ts",
    "launch-test-pod": "tsx scripts/launch-test-pod.ts",
    "terminate-test-pod": "tsx scripts/terminate-test-pod.ts",
    "list-test-pods": "tsx scripts/list-test-pods.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.1",
    "@sentry/node": "^10.49.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "msgpackr": "^1.11.13",
    "pg": "^8.21.0",
    "posthog-node": "^5.29.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.20.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
